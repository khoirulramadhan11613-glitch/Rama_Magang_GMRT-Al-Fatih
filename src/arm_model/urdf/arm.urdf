<?xml version="1.0"?>
<robot name="intern_arm">

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.12 0.12 0.03"/>
            </geometry>
            <origin xyz="0 0 0.015"/>
            <material name="gray">
                <color rgba="0.35 0.35 0.35 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.03"/>
            </geometry>
            <origin xyz="0 0 0.045"/>
            <material name="silver">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>
    </link>

    <link name="link_2">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.04"/>
            </geometry>
            <origin xyz="0 0 0.02"/>
            <material name="blue">
                <color rgba="0.2 0.4 0.8 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <cylinder radius="0.025" length="0.06"/>
            </geometry>
            <origin xyz="0 0 0.04" rpy="1.5708 0 0"/>
            <material name="cyan">
                <color rgba="0.2 0.6 0.7 1"/>
            </material>
        </visual>
    </link>

    <link name="link_3">
        <visual>
            <geometry>
                <box size="0.035 0.04 0.20"/>
            </geometry>
            <origin xyz="0 0 0.10"/>
            <material name="orange">
                <color rgba="0.85 0.45 0.15 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <cylinder radius="0.022" length="0.05"/>
            </geometry>
            <origin xyz="0 0 0.20" rpy="1.5708 0 0"/>
            <material name="yellow">
                <color rgba="0.9 0.75 0.15 1"/>
            </material>
        </visual>
    </link>

    <link name="link_4">
        <visual>
            <geometry>
                <box size="0.03 0.035 0.17"/>
            </geometry>
            <origin xyz="0 0 0.085"/>
            <material name="green">
                <color rgba="0.3 0.55 0.35 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <box size="0.03 0.05 0.02"/>
            </geometry>
            <origin xyz="0 0 0.18"/>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <box size="0.012 0.01 0.04"/>
            </geometry>
            <origin xyz="0 0.015 0.21"/>
            <material name="red">
                <color rgba="0.75 0.2 0.2 1"/>
            </material>
        </visual>

        <visual>
            <geometry>
                <box size="0.012 0.01 0.04"/>
            </geometry>
            <origin xyz="0 -0.015 0.21"/>
            <material name="red">
                <color rgba="0.75 0.2 0.2 1"/>
            </material>
        </visual>
    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_2"/>
        <origin xyz="0 0 0.06"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <joint name="joint_2" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 0.04" rpy="0 0.6 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <joint name="joint_3" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 0.20" rpy="0 -1.3 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
    </joint>

    <ros2_control name="control" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>

        <joint name="joint_1">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>

        <joint name="joint_2">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>

        <joint name="joint_3">
            <command_interface name="position"/>
            <state_interface name="position"/>
        </joint>
    </ros2_control>

</robot>